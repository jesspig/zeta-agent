{
  "name": "zeta-agent-workspace",
  "private": true,
  "type": "module",
  "bin": {
    "zeta": "./apps/zeta-cli/src/index.ts"
  },
  "workspaces": [
    "packages/*",
    "packages/components/*",
    "packages/agent-components/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run build typecheck test",
    "dev": "turbo run dev",
    "zeta": "bun apps/zeta-cli/src/index.ts"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@opentui/solid": "0.9.3",
    "solid-js": "^1.9.16"
  }
}
