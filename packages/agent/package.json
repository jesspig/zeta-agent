{
  "name": "@zeta-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./facade": "./src/facade.ts",
    "./cli/modes": "./src/cli/modes.ts",
    "./providers/openai": "./src/providers/openai.ts",
    "./providers/openai-responses": "./src/providers/openai-responses.ts",
    "./providers/model-discovery": "./src/providers/model-discovery.ts",
    "./providers/models-dev": "./src/providers/models-dev.generated.ts",
    "./providers/model-catalog": "./src/providers/model-catalog.ts",
    "./providers/catalog": "./src/providers/catalog.generated.ts",
    "./providers/registry": "./src/providers/registry.ts",
    "./providers/dispatch": "./src/providers/dispatch.ts",
    "./providers/oauth": "./src/providers/oauth.ts",
    "./providers/image": "./src/providers/image.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zeta-agent/agent-framework": "workspace:*",
    "@zeta-agent/capabilities": "workspace:*",
    "@zeta-agent/framework": "workspace:*",
    "@zeta-agent/observability": "workspace:*",
    "@zeta-agent/security": "workspace:*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  }
}
