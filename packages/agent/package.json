{
  "name": "@zeta-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./facade": "./src/facade.ts",
    "./cli/modes": "./src/cli/modes.ts",
    "./providers/openai": "./src/providers/openai.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zeta-agent/agent-framework": "workspace:*",
    "@zeta-agent/capabilities": "workspace:*",
    "@zeta-agent/framework": "workspace:*",
    "@zeta-agent/observability": "workspace:*",
    "@zeta-agent/security": "workspace:*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
