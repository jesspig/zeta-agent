{
  "name": "@zeta-agent/security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend.ts",
    "./credentials": "./src/credentials.ts",
    "./egress": "./src/egress.ts",
    "./audit": "./src/audit.ts",
