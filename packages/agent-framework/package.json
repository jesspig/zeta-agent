{
  "name": "@zeta-agent/agent-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./runtime/agent": "./src/runtime/agent.ts",
    "./runtime/inbox": "./src/runtime/inbox.ts",
    "./runtime/loop": "./src/runtime/loop.ts",
    "./runtime/decision": "./src/runtime/decision.ts",
    "./runtime/core": "./src/runtime/core.ts",
    "./plugins/types": "./src/plugins/types.ts",
    "./plugins/hook-chain": "./src/plugins/hook-chain.ts",
    "./plugins/manager": "./src/plugins/manager.ts",
    "./session/surface": "./src/session/surface.ts",
    "./session/offload": "./src/session/offload.ts",
    "./tools/pipeline": "./src/tools/pipeline.ts",
    "./tools/parallel": "./src/tools/parallel.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zeta-agent/framework": "workspace:*",
    "@zeta-agent/cordis": "workspace:*",
    "@zeta-agent/events": "workspace:*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  }
}
