{
  "name": "@zeta-agent/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./slots": "./src/slots.ts",
    "./signal": "./src/signal.ts",
    "./virtual": "./src/virtual.ts",
    "./hud": "./src/hud.ts",
    "./frame": "./src/frame.ts",
    "./backend": "./src/backend.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zeta-agent/agent": "workspace:*",
    "@zeta-agent/framework": "workspace:*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun --external '@opentui/*'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  }
}
